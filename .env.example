# ==============================================================================
# Lead Nation Academy (lnabd.org) - Environment Configuration Template
# ==============================================================================
# Security Notice: NEVER commit actual API keys, passwords, or production secrets.
# All real values must be configured in hosting provider dashboard (Vercel) or local .env.local.
# ==============================================================================

# Core Application Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=replace_with_min_32_char_cryptographically_secure_hmac_secret_key

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key_server_only

# bKash Payment Gateway (ADR 0009 - Standardized Server-Only BKASH_* Variables)
# Modes: closed (default fail-closed), mock (development/test only), live (production PGW)
# Note: PGW_Production_API_Context_Root, PGW_App_Key, and PGW_App_Secret also map automatically
#       to BKASH_BASE_URL / BKASH_API_VERSION / BKASH_APP_KEY / BKASH_APP_SECRET when unset.
#       BKASH_USERNAME and BKASH_PASSWORD remain mandatory for Tokenized Checkout token grant.
BKASH_CHECKOUT_MODE=closed
BKASH_APP_KEY=your_bkash_merchant_app_key
BKASH_APP_SECRET=your_bkash_merchant_app_secret
BKASH_USERNAME=your_bkash_merchant_username
BKASH_PASSWORD=your_bkash_merchant_password
BKASH_BASE_URL=https://tokenized.pay.bka.sh
BKASH_API_VERSION=v1.2.0-beta
BKASH_MODE=0011

# Scheduled Reconciliation Secret (min 32 chars for production Vercel Cron)
CRON_SECRET=replace_with_min_32_char_cron_bearer_secret_key

# Public Status Lookup Gate (defaults to active automatically when mock or live checkout opens)
STATUS_LOOKUP_ENABLED=false

# Resend Transactional Email (Modes: disabled | mock | live)
EMAIL_DISPATCH_MODE=disabled
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=admissions@mail.lnabd.org
RESEND_TO_EMAIL=info@lnabd.org

# Upstash Redis (Distributed Rate Limiting - Server Only)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Cloudflare Turnstile (Anti-Bot Public Form Protection)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Public App URL for Canonical References & Sitemaps
NEXT_PUBLIC_APP_URL=http://localhost:3000

